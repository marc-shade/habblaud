diff --git a/src/window/fleet.rs b/src/window/fleet.rs
new file mode 100644
index 0000000..032f777
--- /dev/null
+++ b/src/window/fleet.rs
@@ -0,0 +1,178 @@
+//! The native fleet office is a local tab pane. Its persisted mod marker lets a
+//! standard Herdr installation display the Habblaud panel if it opens the same document.
+use super::{AppWindow, Axis, Content, Model, Node, Tab, home};
+use gpui::Window;
+use serde_json::{Value, json};
+
+pub(super) fn is_pane(node: &Node) -> bool {
+    matches!(node.content(), Some(Content::Mod { name, props })
+        if name == "habblaud" && props["native"].as_str() == Some("fleet"))
+}
+
+fn ensure_pane(model: &mut Model, adopt: Option<&str>) -> Result<(String, String, String), String> {
+    if let Some(tab) = adopt {
+        if !model
+            .spaces
+            .iter()
+            .any(|s| s.machine.is_none() && s.tab(tab).is_some())
+        {
+            return Err("habblaud.open requires an existing local tab ID".into());
+        }
+    }
+    let found = model.spaces.iter().filter(|s| s.machine.is_none()).find_map(|s| {
+        s.tabs.iter().find_map(|tab| {
+            tab.root
+                .panes()
+                .into_iter()
+                .find(|p| is_pane(p))
+                .map(|p| (s.id.clone(), tab.id.clone(), p.id.clone()))
+        })
+    });
+    let (space, tab, pane) = if let Some(found) = found {
+        if adopt.is_some_and(|requested| requested != found.1) {
+            return Err("The native Fleet office already belongs to another local tab".into());
+        }
+        found
+    } else {
+        let pane = model.fresh_id("p");
+        let block = Node::block(
+            &pane,
+            Content::Mod {
+                name: "habblaud".into(),
+                props: json!({"native":"fleet"}),
+            },
+        );
+        if let Some(id) = adopt {
+            let tab = model.tab(id).ok_or("No such fleet tab")?;
+            let target = tab.focused_pane().ok_or("The selected tab has no pane")?;
+            let space = model.space_of(id).ok_or("No local fleet space")?.id.clone();
+            if !model.split_with(&target, Axis::Row, block) {
+                return Err("Unable to insert the fleet pane".into());
+            }
+            model.tab_mut(id).expect("adopted tab exists").zoomed = Some(pane.clone());
+            (space, id.to_owned(), pane)
+        } else {
+            let tab = model.fresh_id("tb");
+            let new_tab = Tab::with_pane(&tab, "Fleet office", block);
+            let local = model
+                .active_space()
+                .filter(|s| s.machine.is_none())
+                .or_else(|| model.spaces.iter().find(|s| s.machine.is_none()));
+            let space = if let Some(local) = local {
+                let id = local.id.clone();
+                model.add_tab(&id, new_tab);
+                id
+            } else {
+                let id = model.fresh_id("sp");
+                model.add_space(&id, "Habblaud", &home(), new_tab);
+                id
+            };
+            (space, tab, pane)
+        }
+    };
+    model.select_tab(&tab);
+    model.focus_pane(&pane);
+    Ok((space, tab, pane))
+}
+
+impl AppWindow {
+    pub(super) fn shown_fleet_pane(&self) -> Option<String> {
+        if !self.overlays.is_empty()
+            || !self.float_hover.is_empty()
+            || self.pane_drag.is_some()
+            || self.float_drag.is_some()
+            || !self.shows_tab()
+        {
+            return None;
+        }
+        self.model
+            .active_space()
+            .filter(|s| s.machine.is_none())?
+            .active_tab()?
+            .shown()
+            .visible_blocks()
+            .into_iter()
+            .find(|n| is_pane(n))
+            .map(|n| n.id.clone())
+    }
+
+    pub(super) fn update_fleet_visibility(&mut self, window: &mut Window) {
+        if let Some(pane) = self.shown_fleet_pane() {
+            self.mounted_fleet_pane = Some(pane);
+        } else if let Some(pane) = &self.mounted_fleet_pane {
+            if self
+                .model
+                .tab_of(pane)
+                .is_some_and(|tab| tab.root.find(pane).is_some_and(is_pane))
+            {
+                crate::fleet_webview::hide(window);
+            } else {
+                crate::fleet_webview::detach(window);
+                self.mounted_fleet_pane = None;
+            }
+        }
+    }
+
+    pub(super) fn open_fleet(&mut self, args: &Value, window: &mut Window) -> Result<Value, String> {
+        let string_arg = |key: &str| match args.get(key) {
+            None | Some(Value::Null) => Ok(None),
+            Some(Value::String(s)) => Ok(Some(s.as_str())),
+            _ => Err(format!("habblaud.open expects a string for {key}")),
+        };
+        let agent = string_arg("agent")?;
+        if agent.is_some_and(|id| !crate::fleet_webview::public_id(id)) {
+            return Err("Invalid fleet agent ID".into());
+        }
+        let adopt = string_arg("tab")?;
+        self.require_document(None)?;
+        let (space, tab, pane) = ensure_pane(&mut self.model, adopt)?;
+        crate::fleet_webview::select(window, agent)?;
+        Ok(json!({ "space":space, "tab":tab, "pane":pane, "agent":agent }))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn adoption_preserves_the_terminal_and_reuses_the_fleet_pane_from_a_remote_space() {
+        let mut model = Model::default();
+        model.add_space(
+            "local",
+            "local",
+            "/",
+            Tab::new("tab", "Fleet office", "old", "t1"),
+        );
+        model.add_space(
+            "remote",
+            "peer",
+            "/",
+            Tab::new("other", "Fleet office", "peer-pane", "peer/t1"),
+        );
+        model
+            .spaces
+            .iter_mut()
+            .find(|s| s.id == "remote")
+            .unwrap()
+            .machine = Some("peer".into());
+        assert!(ensure_pane(&mut model, Some("other")).is_err());
+        let selected = ensure_pane(&mut model, Some("tab")).unwrap();
+        assert_eq!(model.address_of("old").as_deref(), Some("t1"));
+        assert_eq!(model.tab("tab").unwrap().shown().id, selected.2);
+        model.select_tab("other");
+        assert_eq!(ensure_pane(&mut model, None).unwrap(), selected);
+        assert_eq!(model.active_tab().unwrap().id, "tab");
+        assert_eq!(model.tab("tab").unwrap().root.panes().len(), 2);
+    }
+
+    #[test]
+    fn opening_with_no_spaces_makes_one_local_fleet_tab() {
+        let mut model = Model::default();
+        let first = ensure_pane(&mut model, None).unwrap();
+        assert_eq!(ensure_pane(&mut model, None).unwrap(), first);
+        assert_eq!(model.spaces.len(), 1);
+        assert_eq!(model.tabs().count(), 1);
+        assert!(model.active_tab().unwrap().root.terminals().is_empty());
+    }
+}
