@@ -0,0 +1,106 @@
+//! A single local Habblaud viewport, retained by the GPUI window that owns it.
+//! AppKit access is synchronous on GPUI's UI thread. WebKit owns rendering.
+use gpui::{Bounds, Pixels, Window};
+use raw_window_handle::{HasWindowHandle, RawWindowHandle};
+use serde_json::{Value, json};
+use std::ffi::{CStr, CString, c_char, c_void};
+
+unsafe extern "C" {
+    fn herdr_fleet_render(view: *mut c_void, x: f64, y: f64, width: f64, height: f64);
+    fn herdr_fleet_hide(view: *mut c_void);
+    fn herdr_fleet_detach(view: *mut c_void);
+    fn herdr_fleet_select(view: *mut c_void, agent: *const c_char);
+    fn herdr_fleet_measure(view: *mut c_void) -> bool;
+    fn herdr_fleet_status(view: *mut c_void) -> *mut c_char;
+    fn herdr_fleet_free(text: *mut c_char);
+}
+
+fn native(window: &Window) -> Option<*mut c_void> {
+    match HasWindowHandle::window_handle(window).ok()?.as_raw() {
+        RawWindowHandle::AppKit(handle) => Some(handle.ns_view.as_ptr()),
+        _ => None,
+    }
+}
+pub fn render(window: &mut Window, bounds: Bounds<Pixels>) {
+    if let Some(view) = native(window) {
+        let points = |p: Pixels| f64::from(f32::from(p));
+        // SAFETY: the platform owns this NSView until the UI-thread call returns.
+        unsafe {
+            herdr_fleet_render(
+                view,
+                points(bounds.origin.x),
+                points(bounds.origin.y),
+                points(bounds.size.width),
+                points(bounds.size.height),
+            )
+        };
+    }
+}
+pub fn hide(window: &mut Window) {
+    if let Some(view) = native(window) {
+        unsafe { herdr_fleet_hide(view) };
+    }
+}
+pub fn detach(window: &mut Window) {
+    if let Some(view) = native(window) {
+        unsafe { herdr_fleet_detach(view) };
+    }
+}
+pub(crate) fn public_id(value: &str) -> bool {
+    let Some((host, digest)) = value.split_once(':') else { return false };
+    (1..=128).contains(&host.len())
+        && host.as_bytes()[0].is_ascii_alphanumeric()
+        && host.bytes().all(|c| c.is_ascii_alphanumeric() || matches!(c, b'.' | b'_' | b'-'))
+        && digest.len() == 24
+        && digest.bytes().all(|c| c.is_ascii_digit() || matches!(c, b'a'..=b'f'))
+}
+pub fn select(window: &mut Window, agent: Option<&str>) -> Result<(), String> {
+    if agent.is_some_and(|id| !public_id(id)) {
+        return Err("Expected a public fleet agent ID".into());
+    }
+    let agent = agent.map(CString::new).transpose().map_err(|_| "Invalid fleet agent ID")?;
+    let view = native(window).ok_or("Native Habblaud requires an AppKit window")?;
+    // The native side copies the validated string synchronously.
+    unsafe { herdr_fleet_select(view, agent.as_ref().map_or(std::ptr::null(), |s| s.as_ptr())) };
+    Ok(())
+}
+pub fn measure(window: &mut Window) -> Result<(), String> {
+    let view = native(window).ok_or("Native Habblaud requires an AppKit window")?;
+    if unsafe { herdr_fleet_measure(view) } {
+        Ok(())
+    } else {
+        Err("Show the loaded Fleet office before measuring it; only one measurement can run at a time".into())
+    }
+}
+pub fn diagnostic(window: &mut Window) -> Value {
+    let Some(view) = native(window) else {
+        return json!({"state": "unavailable"});
+    };
+    let text = unsafe { herdr_fleet_status(view) };
+    if text.is_null() {
+        return json!({"state":"unavailable"});
+    }
+    // SAFETY: the bridge returns a freshly allocated, NUL-terminated UTF-8 JSON string.
+    let value = serde_json::from_slice(unsafe { CStr::from_ptr(text).to_bytes() });
+    unsafe { herdr_fleet_free(text) };
+    value.unwrap_or_else(|_| json!({"state":"invalid diagnostic response"}))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::public_id;
+    #[test]
+    fn only_accepts_public_fleet_identifiers() {
+        assert!(public_id("mac-studio:a04a03bc3050410a1b037001"));
+        for wrong in [
+            "",
+            "mac-studio",
+            "x:BAD",
+            "http://127.0.0.1:4749",
+            "x:000000000000000000000000:more",
+            "x]:000000000000000000000000",
+        ] {
+            assert!(!public_id(wrong));
+        }
+    }
+}
