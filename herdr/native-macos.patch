diff --git a/src/fleet_webview.m b/src/fleet_webview.m
new file mode 100644
index 0000000..bb0102f
--- /dev/null
+++ b/src/fleet_webview.m
@@ -0,0 +1,306 @@
+// The GPUI view owns this browser just as it owns its AppKit subviews. The
+// browser never accepts a caller-supplied URL, script, or navigation action.
+#import <AppKit/AppKit.h>
+#import <WebKit/WebKit.h>
+#import <objc/runtime.h>
+#include <stdbool.h>
+
+static NSString *const fleetURL = @"http://127.0.0.1:4749/?lang=en";
+static const char fleetKey;
+
+static BOOL fleetDocument(NSURL *url) {
+    return [url.scheme isEqualToString:@"http"] && [url.host isEqualToString:@"127.0.0.1"]
+        && [url.port isEqualToNumber:@4749] && [url.path isEqualToString:@"/"]
+        && !url.user && !url.password && !url.fragment && (!url.query || [url.query isEqualToString:@"lang=en"]);
+}
+
+@interface HerdrFleet : NSObject <WKNavigationDelegate, WKUIDelegate>
+@property(weak) NSView *host;
+@property(strong) NSView *container;
+@property(strong) WKWebView *web;
+@property(strong) NSTextField *message;
+@property(strong) NSButton *retry;
+@property(strong) id keyMonitor;
+@property(copy) NSString *state;
+@property(copy) NSString *error;
+@property(copy) NSString *agent;
+@property(copy) NSString *selectionState;
+@property(copy) NSDictionary *metrics;
+@property BOOL requested;
+@property BOOL measuring;
+@property NSUInteger selectionGeneration;
+@property NSUInteger measurementGeneration;
+- (void)mount;
+- (void)hide;
+- (void)dispose;
+- (void)applySelection;
+- (BOOL)measure;
+@end
+
+@implementation HerdrFleet
+- (instancetype)init {
+    if ((self = [super init])) {
+        _state = @"unmounted";
+        _selectionState = @"none";
+    }
+    return self;
+}
+- (void)mount {
+    if (self.container) return;
+    self.container = [[NSView alloc] initWithFrame:NSZeroRect];
+    self.container.wantsLayer = YES;
+    self.container.layer.backgroundColor = NSColor.windowBackgroundColor.CGColor;
+    [self.host addSubview:self.container positioned:NSWindowAbove relativeTo:nil];
+    self.message = [NSTextField wrappingLabelWithString:@"Opening local Fleet office…"];
+    self.retry = [NSButton buttonWithTitle:@"Retry local Fleet office" target:self action:@selector(start:)];
+    for (NSView *control in @[self.message, self.retry]) {
+        control.translatesAutoresizingMaskIntoConstraints = NO;
+        [self.container addSubview:control];
+    }
+    [NSLayoutConstraint activateConstraints:@[
+        [self.message.centerXAnchor constraintEqualToAnchor:self.container.centerXAnchor],
+        [self.message.centerYAnchor constraintEqualToAnchor:self.container.centerYAnchor],
+        [self.message.widthAnchor constraintLessThanOrEqualToAnchor:self.container.widthAnchor multiplier:.85],
+        [self.retry.centerXAnchor constraintEqualToAnchor:self.container.centerXAnchor],
+        [self.retry.topAnchor constraintEqualToAnchor:self.message.bottomAnchor constant:8]
+    ]];
+    __weak HerdrFleet *weakSelf = self;
+    self.keyMonitor = [NSEvent addLocalMonitorForEventsMatchingMask:NSEventMaskKeyDown handler:^NSEvent *(NSEvent *event) {
+        HerdrFleet *s = weakSelf;
+        if (!s || !s.web || s.container.hidden || event.window != s.host.window) return event;
+        NSResponder *responder = event.window.firstResponder;
+        if (![responder isKindOfClass:NSView.class] || ![(NSView *)responder isDescendantOf:s.web]) return event;
+        NSEventModifierFlags modifiers = event.modifierFlags & NSEventModifierFlagDeviceIndependentFlagsMask;
+        BOOL command = (modifiers & NSEventModifierFlagCommand) != 0;
+        NSString *key = event.charactersIgnoringModifiers.lowercaseString ?: @"";
+        // Leave Ctrl+letters with WebKit. Passing them to the GPUI key handler
+        // could interrupt a terminal beneath the browser.
+        unichar digit = key.length == 1 ? [key characterAtIndex:0] : 0;
+        BOOL ctrlNavigation = (modifiers & NSEventModifierFlagControl) &&
+            (event.keyCode == 48 || (digit >= '1' && digit <= '9'));
+        if (!command && !ctrlNavigation) return event;
+        // Let WebKit own editing and selection; routed chords use GPUI's current keymap.
+        if (modifiers == NSEventModifierFlagCommand && [@[@"a",@"c",@"v",@"x",@"z"] containsObject:key]) return event;
+        return [s.host performKeyEquivalent:event] ? nil : event;
+    }];
+    [self start:nil];
+}
+- (void)failure:(NSString *)reason {
+    self.state = @"error";
+    self.error = reason;
+    self.message.stringValue = reason;
+    self.message.hidden = NO;
+    self.retry.hidden = NO;
+    self.web.hidden = YES;
+}
+- (void)start:(id)sender {
+    self.retry.hidden = YES;
+    self.error = nil;
+    self.message.stringValue = @"Opening local Fleet office…";
+    self.message.hidden = NO;
+    self.state = @"loading";
+    if (self.web) {
+        [self.web loadRequest:[NSURLRequest requestWithURL:[NSURL URLWithString:fleetURL]]];
+        return;
+    }
+    // Compile before the first request; failure leaves only the native error view.
+    NSString *rules = @"[{\"trigger\":{\"url-filter\":\".*\"},\"action\":{\"type\":\"block\"}},"
+        "{\"trigger\":{\"url-filter\":\"^http://127[.]0[.]0[.]1:4749/\"},\"action\":{\"type\":\"ignore-previous-rules\"}}]";
+    __weak HerdrFleet *weakSelf = self;
+    [WKContentRuleListStore.defaultStore compileContentRuleListForIdentifier:@"HerdrLoopbackFleet-v1" encodedContentRuleList:rules
+        completionHandler:^(WKContentRuleList *list, NSError *error) {
+        HerdrFleet *s = weakSelf;
+        if (!s || !s.container) return;
+        if (!list) { [s failure:error.localizedDescription ?: @"Local Fleet resource policy failed to load."]; return; }
+        WKWebViewConfiguration *config = [[WKWebViewConfiguration alloc] init];
+        config.websiteDataStore = WKWebsiteDataStore.nonPersistentDataStore;
+        config.preferences.javaScriptCanOpenWindowsAutomatically = NO;
+        [config.userContentController addContentRuleList:list];
+        s.web = [[WKWebView alloc] initWithFrame:s.container.bounds configuration:config];
+        s.web.navigationDelegate = s;
+        s.web.UIDelegate = s;
+        s.web.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+        [s.container addSubview:s.web positioned:NSWindowBelow relativeTo:s.message];
+        [s.web loadRequest:[NSURLRequest requestWithURL:[NSURL URLWithString:fleetURL]]];
+    }];
+}
+- (void)webView:(WKWebView *)web decidePolicyForNavigationAction:(WKNavigationAction *)action decisionHandler:(void (^)(WKNavigationActionPolicy))decide {
+    BOOL allowed = action.targetFrame && action.targetFrame.mainFrame && fleetDocument(action.request.URL)
+        && [action.request.HTTPMethod isEqualToString:@"GET"];
+    if (!allowed && [self.state isEqual:@"loading"] && action.targetFrame.mainFrame) {
+        [self failure:@"The Fleet office tried to leave its local page."];
+    }
+    decide(allowed ? WKNavigationActionPolicyAllow : WKNavigationActionPolicyCancel);
+}
+- (void)webView:(WKWebView *)web decidePolicyForNavigationResponse:(WKNavigationResponse *)response decisionHandler:(void (^)(WKNavigationResponsePolicy))decide {
+    BOOL ok = response.forMainFrame && fleetDocument(response.response.URL) && [response.response.MIMEType isEqualToString:@"text/html"];
+    if (!ok && [self.state isEqual:@"loading"] && response.forMainFrame) {
+        [self failure:@"The local Fleet office did not return its HTML page."];
+    }
+    if (ok && [response.response isKindOfClass:NSHTTPURLResponse.class]) {
+        NSInteger code = [(NSHTTPURLResponse *)response.response statusCode];
+        ok = code >= 200 && code < 300;
+        if (!ok) [self failure:[NSString stringWithFormat:@"Local Fleet office returned HTTP %ld.", (long)code]];
+    }
+    decide(ok ? WKNavigationResponsePolicyAllow : WKNavigationResponsePolicyCancel);
+}
+- (WKWebView *)webView:(WKWebView *)web createWebViewWithConfiguration:(WKWebViewConfiguration *)config
+     forNavigationAction:(WKNavigationAction *)action windowFeatures:(WKWindowFeatures *)features { return nil; }
+- (void)webView:(WKWebView *)web didFinishNavigation:(WKNavigation *)navigation {
+    if (!fleetDocument(web.URL)) return;
+    self.state = @"ready";
+    self.error = nil;
+    self.message.hidden = YES;
+    self.retry.hidden = YES;
+    web.hidden = NO;
+    [self applySelection];
+}
+- (void)webView:(WKWebView *)web didFailProvisionalNavigation:(WKNavigation *)navigation withError:(NSError *)error {
+    if (error.code != NSURLErrorCancelled) [self failure:error.localizedDescription];
+}
+- (void)webView:(WKWebView *)web didFailNavigation:(WKNavigation *)navigation withError:(NSError *)error {
+    if (error.code != NSURLErrorCancelled) [self failure:error.localizedDescription];
+}
+- (void)webViewWebContentProcessDidTerminate:(WKWebView *)web {
+    self.measurementGeneration++;
+    self.measuring = NO;
+    [self failure:@"The Fleet office browser process stopped."];
+}
+- (void)hide {
+    if (!self.container || self.container.hidden) return;
+    NSResponder *responder = self.host.window.firstResponder;
+    if ([responder isKindOfClass:NSView.class] && [(NSView *)responder isDescendantOf:self.container]) {
+        [self.host.window makeFirstResponder:self.host];
+    }
+    self.container.hidden = YES;
+    if (self.measuring) {
+        self.measuring = NO;
+        self.measurementGeneration++;
+        self.metrics = @{@"state":@"cancelled", @"reason":@"Fleet office was hidden during measurement"};
+    }
+}
+- (void)dispose {
+    [self hide];
+    if (self.keyMonitor) [NSEvent removeMonitor:self.keyMonitor];
+    self.keyMonitor = nil;
+    self.web.navigationDelegate = nil;
+    self.web.UIDelegate = nil;
+    [self.web stopLoading];
+    [self.container removeFromSuperview];
+    self.web = nil;
+    self.container = nil;
+}
+- (void)dealloc {
+    if (_keyMonitor) [NSEvent removeMonitor:_keyMonitor];
+}
+- (void)applySelection {
+    if (!self.requested || ![self.state isEqual:@"ready"] || !self.web) return;
+    self.selectionState = @"pending";
+    NSUInteger generation = ++self.selectionGeneration;
+    // Arguments are structured WebKit values in an isolated JavaScript world.
+    // A new request cancels the preceding DOM wait even if its agent appears later.
+    NSString *body = @"if(globalThis.cancelFleetSelection)globalThis.cancelFleetSelection();"
+        "return await new Promise(resolve=>{"
+        "let observer,timer;const finish=x=>{observer?.disconnect();clearTimeout(timer);"
+        "delete globalThis.cancelFleetSelection;resolve(x)};"
+        "globalThis.cancelFleetSelection=()=>finish('superseded');"
+        "const select=()=>{const button=agent===null?document.querySelector('#overview'):"
+        "Array.from(document.querySelectorAll('button[data-agent]')).find(e=>e.dataset.agent===agent);"
+        "if(!button || typeof button.onclick!=='function' && !document.querySelector('#nodes article'))return;"
+        "button.click();finish('selected')};"
+        "observer=new MutationObserver(select);observer.observe(document.body,{childList:true,subtree:true});"
+        "timer=setTimeout(()=>finish('unavailable'),15000);select()});";
+    __weak HerdrFleet *weakSelf = self;
+    [self.web callAsyncJavaScript:body arguments:@{@"agent":self.agent ?: NSNull.null} inFrame:nil inContentWorld:WKContentWorld.defaultClientWorld
+        completionHandler:^(id value, NSError *error) {
+        HerdrFleet *s = weakSelf;
+        if (!s || s.selectionGeneration != generation) return;
+        s.selectionState = error ? @"failed" : ([value isKindOfClass:NSString.class] ? value : @"failed");
+        if (error) s.error = error.localizedDescription;
+    }];
+}
+- (BOOL)measure {
+    if (self.measuring || !self.container || self.container.hidden || ![self.state isEqual:@"ready"] || !self.host.window.visible) return NO;
+    self.measuring = YES;
+    self.metrics = @{@"state":@"sampling"};
+    NSUInteger generation = ++self.measurementGeneration;
+    // No sampling in normal operation. Compare the browser's actual fleet canvas
+    // at the ends of the run and keep pixel readbacks outside the timed interval.
+    NSString *body = @"const c=document.querySelector('canvas#world');"
+        "if(!c||!c.width||!c.height||document.visibilityState!=='visible')throw Error('Visible fleet canvas required');"
+        "const tiny=document.createElement('canvas');tiny.width=128;tiny.height=72;"
+        "const ctx=tiny.getContext('2d',{willReadFrequently:true});"
+        "const pixels=()=>{ctx.drawImage(c,0,0,128,72);return ctx.getImageData(0,0,128,72).data};"
+        "const first=pixels(),ts=[];"
+        "await new Promise((resolve,reject)=>{const timer=setTimeout(()=>reject(Error('Frame sample timed out')),10000);"
+        "const tick=t=>{ts.push(t);if(ts.length===121){clearTimeout(timer);resolve()}else requestAnimationFrame(tick)};requestAnimationFrame(tick)});"
+        "const last=pixels(),dt=ts.slice(1).map((t,i)=>t-ts[i]).sort((a,b)=>a-b);"
+        "let changed=0;for(let i=0;i<last.length;i+=4)if(first[i]!==last[i]||first[i+1]!==last[i+1]||first[i+2]!==last[i+2])changed++;"
+        "return {state:'complete',intervals:120,elapsedMs:ts[120]-ts[0],fps:120000/(ts[120]-ts[0]),"
+        "medianMs:(dt[59]+dt[60])/2,p95Ms:dt[113],maxMs:dt[119],changedSamplePixels:changed,"
+        "canvasWidth:c.width,canvasHeight:c.height,devicePixelRatio:devicePixelRatio,"
+        "locale:document.documentElement.lang,agentButtons:document.querySelectorAll('button[data-agent]').length};";
+    __weak HerdrFleet *weakSelf = self;
+    [self.web callAsyncJavaScript:body arguments:@{} inFrame:nil inContentWorld:WKContentWorld.defaultClientWorld
+        completionHandler:^(id result, NSError *error) {
+        HerdrFleet *s = weakSelf;
+        if (!s || generation != s.measurementGeneration) return;
+        s.measuring = NO;
+        s.metrics = !error && [result isKindOfClass:NSDictionary.class] ? result
+            : @{@"state":@"failed", @"error":error.localizedDescription ?: @"Invalid frame statistics"};
+    }];
+    return YES;
+}
+@end
+
+static HerdrFleet *session(void *native, BOOL create) {
+    NSView *host = (__bridge NSView *)native;
+    HerdrFleet *s = objc_getAssociatedObject(host, &fleetKey);
+    if (!s && create) {
+        s = [[HerdrFleet alloc] init];
+        s.host = host;
+        objc_setAssociatedObject(host, &fleetKey, s, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    }
+    return s;
+}
+void herdr_fleet_render(void *view, double x, double y, double width, double height) {
+    HerdrFleet *s = session(view, YES);
+    NSRect b = s.host.bounds;
+    if (!isfinite(x) || !isfinite(y) || !isfinite(width) || !isfinite(height) || width <= 0 || height <= 0) { [s hide]; return; }
+    NSRect frame = NSMakeRect(NSMinX(b)+x, s.host.flipped ? NSMinY(b)+y : NSMaxY(b)-y-height, width, height);
+    frame = NSIntersectionRect(frame, b);
+    if (NSIsEmptyRect(frame)) { [s hide]; return; }
+    [s mount];
+    if (!NSEqualRects(s.container.frame, frame)) s.container.frame = frame;
+    if (s.container.hidden) s.container.hidden = NO;
+}
+void herdr_fleet_hide(void *view) { [session(view, NO) hide]; }
+void herdr_fleet_detach(void *view) {
+    [session(view, NO) dispose];
+    objc_setAssociatedObject((__bridge NSView *)view, &fleetKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
+void herdr_fleet_select(void *view, const char *agent) {
+    HerdrFleet *s = session(view, YES);
+    s.requested = YES;
+    s.agent = agent ? [NSString stringWithUTF8String:agent] : nil;
+    s.selectionState = @"pending";
+    [s applySelection];
+}
+bool herdr_fleet_measure(void *view) { return [session(view, NO) measure]; }
+char *herdr_fleet_status(void *view) {
+    HerdrFleet *s = session(view, NO);
+    NSRect r = s.container.frame;
+    NSNumber *maxFPS = nil;
+    if (@available(macOS 12.0, *)) maxFPS = @(s.host.window.screen.maximumFramesPerSecond);
+    NSDictionary *summary = @{
+        @"renderer":@"WKWebView", @"state":s.state ?: @"unmounted", @"visible":@(s.container && !s.container.hidden && s.host.window.visible),
+        @"selection":s.selectionState ?: @"none", @"requestedAgent":s.agent ?: NSNull.null,
+        @"measurement":s.metrics ?: NSNull.null, @"loadError":s.error ?: NSNull.null,
+        @"framePoints":@{@"x":@(r.origin.x),@"y":@(r.origin.y),@"width":@(r.size.width),@"height":@(r.size.height)},
+        @"backingScale":@(s.host.window.backingScaleFactor), @"screenMaxFPS":maxFPS ?: NSNull.null
+    };
+    NSData *data = [NSJSONSerialization dataWithJSONObject:summary options:0 error:nil];
+    NSString *text = data ? [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding] : nil;
+    return text ? strdup(text.UTF8String) : NULL;
+}
+void herdr_fleet_free(char *text) { free(text); }
